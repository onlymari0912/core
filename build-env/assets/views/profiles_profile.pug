extends _layout.pug

block content
  section.section.is-main-section
    .columns
      .column
        .card
          header.card-header
            p.card-header-title
              span.icon
                i.mdi.mdi-account
              | 상세정보
          .card-content
            .columns
              .column.is-narrow
                .image.is-64x64#profile-icon(jdenticon=profile.name jdenticon-size=64)
              .column
                .field.is-horizontal.is-narrow(data-tooltip="4자리 인게임 비밀번호")
                  .field-label
                    label.label Ref ID
                  .field-body
                    .field
                      .control
                        span.tag.is-info#refid #{profile.__refid}
                form(method='post')
                  .field.is-horizontal.is-narrow
                    .field-label.is-normal
                      label.label PIN
                    .field-body
                      .field
                        .control
                          input.input(type='password' size='4' maxlength='4' placeholder='••••' name='pin')
                  .field.is-horizontal.is-narrow(data-tooltip="웹페이지에서만 사용됩니다")
                    .field-label.is-normal
                      label.label 닉네임
                    .field-body
                      .field
                        .control
                          input.input#name-input(type='text' placeholder=profile.name name='name')
                  .field.is-horizontal.is-narrow(data-tooltip="Asphyxia 인증 아이디")
                    .field-label.is-normal
                      label.label 아이디
                    .field-body
                      .field
                        .control
                          input.input(type='text' name='username' placeholder=profile.username)
                  .field.is-horizontal.is-narrow(data-tooltip="Asphyxia 인증 비밀번호")
                    .field-label.is-normal
                      label.label 비밀번호
                    .field-body
                      .field
                        .control
                          input.input(type='password' name='password' autocomplete='new-password')
                  .field.is-grouped
                    .control.is-expanded
                      if formMessage
                        if formMessage.danger
                          .notification.is-danger.is-light #{formMessage.message}
                        else
                          .notification.is-success.is-light #{formMessage.message}
                    .control
                      button.button.is-link(type='submit')
                        span.icon.is-small
                          i.mdi.mdi-pencil
                        span Change
      .column
        .card
          header.card-header
            p.card-header-title
              span.icon
                i.mdi.mdi-account
              | 등록된 카드 목록
          .card-content
            .field.is-horizontal.is-narrow
              .field-label.is-normal
                label.label 추가
              .field-body
                .field.has-addons
                  .control.is-expanded
                    input.input#card-input(type='text' placeholder='카드번호 입력' name='card')
                  .control
                    button.button.is-primary#add-card
                      span.icon.is-small
                        i.mdi.mdi-plus
            each card in profile.cards
              .ecard.box.is-paddingless(geopattern=card.cid)
                .ecard-brand ASPHYXIA
                .ecard-print  
                  .desc 카드번호
                  .print #{card.print.replace(/[^a-z0-9]+/gi, '').replace(/(.{4})/g, '$1 ')}
                .ecard-number 
                  .desc NFC
                  .print #{card.cid}
                .ecard-logo
                button.button.is-danger.ecard-delete(deleting=card.cid data-tooltip="카드 제거")
                  span.icon
                    i.mdi.mdi-trash-can.mdi-24px

block scripts
  script(type="text/javascript" src="/static/js/profile.js")